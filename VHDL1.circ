  <vhdl appearance="logisim_evolution" name="logic_test">
library ieee;
use ieee.std_logic_1164.all;

entity logic_test is
    port(
        a, b, c, d : in std_logic;
        out1, out2 : out std_logic
    );
end entity logic_test;

architecture bhv of logic_test is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8_1">&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity mux8_1 is&#13;
    port(&#13;
        a, b, c, d, e, f, g, h : in std_logic;&#13;
        ch : in std_logic_vector(2 downto 0);&#13;
        data : out std_logic&#13;
    );&#13;
end entity mux8_1;&#13;
&#13;
architecture bhv of mux8_1 is&#13;
begin&#13;
    process(a, b, c, d, e, f, g, h, ch)&#13;
    begin&#13;
        case ch is&#13;
            when "000" =&gt; data &lt;= a;&#13;
            when "001" =&gt; data &lt;= b;&#13;
            when "010" =&gt; data &lt;= c;&#13;
            when "011" =&gt; data &lt;= d;&#13;
            when "100" =&gt; data &lt;= e;&#13;
            when "101" =&gt; data &lt;= f;&#13;
            when "110" =&gt; data &lt;= g;&#13;
            when "111" =&gt; data &lt;= h;&#13;
            when others =&gt; data &lt;= '0';&#13;
        end case;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="segment_letters">&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity segment_letters is&#13;
    port(&#13;
        ch : in std_logic_vector(2 downto 0);&#13;
        display : out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity segment_letters;&#13;
&#13;
architecture bhv of segment_letters is&#13;
begin&#13;
    process(ch)&#13;
    begin&#13;
        case ch is&#13;
            -- Bit order: a b c d e f g dp&#13;
            when "000" =&gt; display &lt;= "11111010"; -- a&#13;
            when "001" =&gt; display &lt;= "00111110"; -- b&#13;
            when "010" =&gt; display &lt;= "00011010"; -- c&#13;
            when "011" =&gt; display &lt;= "01111010"; -- d&#13;
            when "100" =&gt; display &lt;= "10001110"; -- f&#13;
            when "101" =&gt; display &lt;= "11110110"; -- g&#13;
            when others =&gt; display &lt;= "00000000";&#13;
        end case;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="vote25">&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity vote25 is&#13;
    port(&#13;
        vt : in std_logic_vector(24 downto 0);&#13;
        result : out std_logic&#13;
    );&#13;
end entity vote25;&#13;
&#13;
architecture bhv of vote25 is&#13;
begin&#13;
    process(vt)&#13;
        variable sum : integer range 0 to 25;&#13;
    begin&#13;
        sum := 0;&#13;
&#13;
        for i in 0 to 24 loop&#13;
            if vt(i) = '1' then&#13;
                sum := sum + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if sum &gt;= 13 then&#13;
            result &lt;= '1';&#13;
        else&#13;
            result &lt;= '0';&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
  <vhdl appearance="logisim_evolution" name="counter7seg">&#13;
library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity counter7seg is&#13;
    port(&#13;
        vt      : in std_logic_vector(12 downto 0);&#13;
        en      : in std_logic;&#13;
        display : out std_logic_vector(7 downto 0)&#13;
    );&#13;
end entity counter7seg;&#13;
&#13;
architecture bhv of counter7seg is&#13;
begin&#13;
    process(vt, en)&#13;
        variable sum : integer range 0 to 15;&#13;
    begin&#13;
        sum := 0;&#13;
&#13;
        for i in 0 to 12 loop&#13;
            if vt(i) = '1' then&#13;
                sum := sum + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if en = '0' then&#13;
            display &lt;= "00000000";&#13;
        else&#13;
            case sum is&#13;
                -- Bit order: a b c d e f g dp&#13;
                when 0  =&gt; display &lt;= "11111100";&#13;
                when 1  =&gt; display &lt;= "01100000";&#13;
                when 2  =&gt; display &lt;= "11011010";&#13;
                when 3  =&gt; display &lt;= "11110010";&#13;
                when 4  =&gt; display &lt;= "01100110";&#13;
                when 5  =&gt; display &lt;= "10110110";&#13;
                when 6  =&gt; display &lt;= "10111110";&#13;
                when 7  =&gt; display &lt;= "11100000";&#13;
                when 8  =&gt; display &lt;= "11111110";&#13;
                when 9  =&gt; display &lt;= "11110110";&#13;
                when 10 =&gt; display &lt;= "11101110"; -- A&#13;
                when 11 =&gt; display &lt;= "00111110"; -- b&#13;
                when 12 =&gt; display &lt;= "10011100"; -- C&#13;
                when 13 =&gt; display &lt;= "01111010"; -- d&#13;
                when 14 =&gt; display &lt;= "10011110"; -- E&#13;
                when 15 =&gt; display &lt;= "10001110"; -- F&#13;
                when others =&gt; display &lt;= "00000000";&#13;
            end case;&#13;
        end if;&#13;
    end process;&#13;
end architecture bhv;&#13;
</vhdl>
</project>
